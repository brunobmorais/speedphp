{% set metaDescription = (HEAD.description|default('')|striptags|trim)|length > 0 ? (HEAD.description|default('')|striptags|trim) : CONFIG_HEADER.description %}
{% set ogImage = (HEAD.image|default('')|trim)|length > 0 ? HEAD.image|default('')|trim : CONFIG_HEADER.image %}
{% set ogImageType = HEAD.image_type|default('')|trim %}
{% if ogImageType|length == 0 %}
    {% set ogImageExt = ogImage|split('.')|last|lower %}
    {% set ogImageType = ogImageExt in ['jpg', 'jpeg'] ? 'image/jpeg' : (ogImageExt == 'webp' ? 'image/webp' : (ogImageExt == 'gif' ? 'image/gif' : 'image/png')) %}
{% endif %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="content-language" content="pt-BR"/>
<meta http-equiv="content-type" content="text/html; charset=UTF-8"/>
<meta name="robots" content="index, follow">
<meta name='googlebot' content='index,follow'>
<meta name="author" content="{{ HEAD.author|length>0 ? HEAD.author : CONFIG_HEADER.author }}"/>
<meta name="keywords" content="{{ HEAD.keywords|length>0 ? HEAD.keywords : CONFIG_HEADER.keywords }}">
<meta name="description" content="{{ metaDescription }}">
<link rel='canonical' href='{{ HEAD.url|length>0 ? HEAD.url : CONFIG_HEADER.url }}'/>
<meta name="format-detection" content="telephone=no">

<title>{{ HEAD.title }}</title>

<meta property="og:title" content="{{ HEAD.title }}">
<meta property="og:url" content="{{ HEAD.url|length>0 ? HEAD.url : CONFIG_HEADER.url }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:type" content="{{ ogImageType }}">
{% if ogImage starts with 'https://' %}
    <meta property="og:image:secure_url" content="{{ ogImage }}">
{% endif %}
<meta property="og:description" content="{{ metaDescription }}">
<meta property="og:site_name" content="{{ HEAD.title }}">
<meta property='og:type' content='website'/>
<meta property='og:locale' content='pt_BR'>

<meta name="twitter:title" content="{{ HEAD.title }}">
<meta name="twitter:description" content="{{ metaDescription }}">
<meta name="twitter:image" content="{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image:alt" content="{{ HEAD.title }}">
<meta name="twitter:site" content="{{ HEAD.author|length>0 ? HEAD.author : CONFIG_HEADER.author }}">
<meta name="twitter:creator" content="{{ HEAD.author|length>0 ? HEAD.author : CONFIG_HEADER.author }}">

<meta name="application-name" content="{{ HEAD.title }}">
<meta name="mobile-web-app-capable" content="yes">

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="{{ HEAD.title }}">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel='apple-touch-startup-image' href='/assets/img/icon/apple-icon-180x180.png?v={{ CONFIG_VERSION_CODE }}'>

<meta name='msapplication-TileColor' content='{{ color }}'>
<meta name="msapplication-TileImage" content="/assets/img/icon/ms-icon-144x144.png?v={{ CONFIG_VERSION_CODE }}">
<meta name='msapplication-starturl' content='/'>

{# ICON #}
<link rel="apple-touch-icon" sizes="57x57" href="/assets/img/icon/apple-icon-57x57.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="60x60" href="/assets/img/icon/apple-icon-60x60.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="72x72" href="/assets/img/icon/apple-icon-72x72.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="76x76" href="/assets/img/icon/apple-icon-76x76.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="114x114" href="/assets/img/icon/apple-icon-114x114.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="120x120" href="/assets/img/icon/apple-icon-120x120.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="144x144" href="/assets/img/icon/apple-icon-144x144.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="152x152" href="/assets/img/icon/apple-icon-152x152.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/icon/apple-icon-180x180.png?v={{ CONFIG_VERSION_CODE }}">
<link rel="icon" type="image/png" sizes="192x192"
      href="/assets/img/icon/android-icon-192x192.png?v={{ CONFIG_VERSION_CODE }}">
